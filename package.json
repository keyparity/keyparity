{
  "name": "keyparity",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/picomatch": "^4.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7"
  },
  "version": "0.1.1",
  "description": "Check that every env var your code uses is in .env.example and GitHub Secrets. Reads names only, never values.",
  "license": "MIT",
  "bin": {
    "keyparity": "dist/cli.js"
  },
  "files": [
    "dist/cli.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyparity/keyparity.git"
  },
  "homepage": "https://github.com/keyparity/keyparity#readme",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/keyparity",
    "build:npm": "bun build src/cli.ts --target=node --minify --outfile dist/cli.js",
    "prepublishOnly": "bun run typecheck && bun test && bun run build:npm"
  },
  "engines": {
    "node": ">=20"
  }
}
